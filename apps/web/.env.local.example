# Local / Cloudflare Pages public env (placeholders only — no secrets).
# Copy to `.env.local` for local next dev.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
NEXT_PUBLIC_TURNSTILE_SITE_KEY=YOUR_CLOUDFLARE_TURNSTILE_SITE_KEY

# Optional UPI payee VPA used in challan settlement deep-links
NEXT_PUBLIC_UPI_VPA=vahankavach@upi

# Telegram bot username (no @) for Connect Telegram deep-links: t.me/<BOT>?start=<token>
NEXT_PUBLIC_TELEGRAM_BOT_NAME=VahanKavachBot

# Razorpay publishable key (optional; checkout also returns keyId from Edge)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
