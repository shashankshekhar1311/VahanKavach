## Copy to local.properties (gitignored) and fill values.
## SDK path — Android Studio usually writes this automatically:
# sdk.dir=C\:\\Users\\YOU\\AppData\\Local\\Android\\Sdk

## Supabase Cloud (Project Settings → API)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_OR_PUBLISHABLE_KEY

## Telegram bot username without @ (Connect Telegram deep-link)
TELEGRAM_BOT_NAME=VahanKavachBot
