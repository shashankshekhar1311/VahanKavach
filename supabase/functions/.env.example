# Local `supabase functions serve` secrets for sandbox.
# Copy to supabase/functions/.env (gitignored).

ENVIRONMENT=staging
VEHICLE_PROVIDER=MOCK
# VEHICLE_PROVIDER=SETU_SANDBOX

TELEGRAM_BOT_TOKEN=<STAGING_TELEGRAM_BOT_TOKEN>
TELEGRAM_BOT_USERNAME=VahanKavachDevBot

SETU_BASE_URL=https://sandbox.setu.co/api/v1
SETU_CLIENT_ID=mock_setu_client_id
SETU_CLIENT_SECRET=mock_setu_client_secret
SETU_AUTH_MODE=headers

RAZORPAY_KEY_ID=rzp_test_xxxx
RAZORPAY_KEY_SECRET=test_secret_xxxx

APP_BASE_URL=http://localhost:3000
