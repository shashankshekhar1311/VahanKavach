# Copy to supabase/functions/.env for local `supabase functions serve`.
# Never commit real tokens.
#
# Hosted project (replace values, do not commit secrets):
#   npx supabase secrets set \
#     WHATSAPP_WEBHOOK_VERIFY_TOKEN="your-verify-token" \
#     META_APP_SECRET="your-meta-app-secret" \
#     WHATSAPP_ACCESS_TOKEN="your-cloud-api-token" \
#     WHATSAPP_PHONE_NUMBER_ID="your-phone-number-id" \
#     APP_BASE_URL="https://vahankavach.app" \
#     PAYMENT_PORTAL_URL="https://vahankavach.app/challans/pay" \
#     USE_MOCK_PROVIDER="true"

# --- Module 2: VAHAN / e-challan provider ---
USE_MOCK_PROVIDER=true
SUREPASS_API_TOKEN=
SUREPASS_BASE_URL=https://kyc-api.surepass.io/api/v1
SUREPASS_TIMEOUT_MS=10000

# --- Module 3: Meta WhatsApp Cloud API ---
# Meta App Dashboard → WhatsApp → Configuration → Verify token (must match webhook GET)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=dev-verify-token-change-me

# Meta App Dashboard → Settings → Basic → App Secret (HMAC for x-hub-signature-256)
META_APP_SECRET=

# WhatsApp → API Setup → temporary or permanent access token
WHATSAPP_ACCESS_TOKEN=

# WhatsApp → API Setup → Phone number ID (not the display number)
WHATSAPP_PHONE_NUMBER_ID=

# Deep links used in onboarding / pay CTAs
APP_BASE_URL=https://vahankavach.app
PAYMENT_PORTAL_URL=https://vahankavach.app/challans/pay

# --- Module 4: proactive PUC alerts (send-puc-alert) ---
# Optional approved Meta template for outbound outside the 24h window.
# Body params expected: {{1}} reg number, {{2}} urgency phrase, {{3}} expiry date.
# If unset, WhatsApp provider falls back to a formatted text message.
WHATSAPP_PUC_TEMPLATE_NAME=
WHATSAPP_PUC_TEMPLATE_LANG=en

# --- Multi-channel notifications (Telegram default) ---
# BotFather → token for api.telegram.org/bot<TOKEN>/sendMessage
TELEGRAM_BOT_TOKEN=

# Optional secret passed when setWebhook(..., secret_token=...)
TELEGRAM_WEBHOOK_SECRET=

# Public bot username without @ (also expose to web as NEXT_PUBLIC_TELEGRAM_BOT_NAME)
TELEGRAM_BOT_NAME=VahanKavachBot
